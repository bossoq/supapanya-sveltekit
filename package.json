{
  "name": "simplesveltekittemplate",
  "description": "A simple SvelteKit template with TailwindCSS and TypeScript",
  "author": "Kittipos Wajakajornrit",
  "repository": "https://github.com/bossoq/simple-sveltekit-template",
  "version": "1.2.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^22.8.4",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.6.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.2.7",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-multiselect": "^11.8.0",
    "tailwindcss": "^3.2.4",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "type": "module",
  "dependencies": {
    "@google-apps/meet": "^0.11.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tiptap/core": "^2.9.1",
    "@tiptap/extension-bubble-menu": "^2.9.1",
    "@tiptap/extension-focus": "^2.9.1",
    "@tiptap/extension-heading": "^2.27.2",
    "@tiptap/extension-image": "^2.9.1",
    "@tiptap/extension-link": "^2.9.1",
    "@tiptap/extension-table": "^2.9.1",
    "@tiptap/extension-table-cell": "^2.9.1",
    "@tiptap/extension-table-header": "^2.9.1",
    "@tiptap/extension-table-row": "^2.9.1",
    "@tiptap/extension-text-align": "^2.9.1",
    "@tiptap/extension-underline": "^2.9.1",
    "@tiptap/html": "^2.9.1",
    "@tiptap/pm": "^2.9.1",
    "@tiptap/starter-kit": "^2.9.1",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "flatpickr": "^4.6.13",
    "google-auth-library": "^11.3.2",
    "hls.js": "^1.7.4",
    "jwt-simple": "^0.5.6",
    "media-icons": "^1.1.5",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "remixicon": "^4.4.0",
    "sharp": "^0.35.5",
    "vidstack": "^1.15.7"
  }
}
