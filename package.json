{
  "name": "simplesveltekittemplate",
  "description": "A simple SvelteKit template with TailwindCSS and TypeScript",
  "author": "Kittipos Wajakajornrit",
  "repository": "https://github.com/bossoq/simple-sveltekit-template",
  "version": "1.2.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-multiselect": "^11.8.0",
    "tailwindcss": "^3.2.4",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "dependencies": {
    "@google-apps/meet": "^0.11.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-bubble-menu": "^3.32.1",
    "@tiptap/extension-focus": "^3.32.1",
    "@tiptap/extension-heading": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-link": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extension-table-cell": "^3.32.1",
    "@tiptap/extension-table-header": "^3.32.1",
    "@tiptap/extension-table-row": "^3.32.1",
    "@tiptap/extension-text-align": "^3.32.1",
    "@tiptap/extension-underline": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "flatpickr": "^4.6.13",
    "google-auth-library": "^11.3.2",
    "hls.js": "^1.7.4",
    "jose": "^6.2.14",
    "media-icons": "^1.1.5",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "remixicon": "^4.4.0",
    "sharp": "^0.35.5",
    "vidstack": "^1.15.7",
    "zeed-dom": "^0.18.0"
  }
}
